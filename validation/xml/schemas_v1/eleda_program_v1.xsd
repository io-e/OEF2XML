            <xs:enumeration value="it"/>
            <xs:enumeration value="de"/>
            <xs:enumeration value="ar"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="title" type="xs:string"/>
  <xs:element name="description" type="xs:string"/>
  <!--
    ====================================================================
    Variable declaration
    ====================================================================
  -->
  <xs:element name="variable">
    <xs:complexType mixed="true">
      <xs:attribute name="id" use="required"/>
      <xs:attribute name="type"/>
    </xs:complexType>
  </xs:element>
  <!--
    ====================================================================
    Blockly block (recursive)
    ====================================================================
  -->
  <xs:element name="block">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" ref="ns1:extraState"/>
        <xs:element minOccurs="0" ref="ns1:icons"/>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="ns1:field"/>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="ns1:input"/>
        <xs:element minOccurs="0" ref="ns1:next"/>
      </xs:sequence>
      <xs:attribute name="type" use="required" type="ns1:block-type-enum"/>
      <xs:attribute name="id"/>
      <xs:attribute name="x"/>
      <xs:attribute name="y"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="extraState">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="ns1:any-content">
          <xs:attribute name="format"/>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="icons">
    <xs:complexType>
      <xs:group minOccurs="0" maxOccurs="unbounded" ref="ns1:icon-element"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="next">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="ns1:block"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <!--
    ====================================================================
    Field
    ====================================================================
  -->
  <xs:element name="field">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="ns1:any-content">
          <xs:attribute name="name" use="required"/>
          <xs:attribute name="id"/>
          <xs:attribute name="variabletype"/>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <!--
    ====================================================================
    Input (contains block and/or shadow)
    ====================================================================
  -->
  <xs:element name="input">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" ref="ns1:block"/>
        <xs:element minOccurs="0" ref="ns1:shadow"/>
      </xs:sequence>
      <xs:attribute name="name" use="required"/>
    </xs:complexType>
  </xs:element>
  <!--
    ====================================================================
    Shadow block
    ====================================================================
  -->
  <xs:element name="shadow">
    <xs:complexType>
      <xs:sequence>
