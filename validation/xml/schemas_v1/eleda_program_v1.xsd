    Root element
    ====================================================================
  -->
  <xs:element name="eleda-program">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="ns1:name"/>
        <xs:element minOccurs="0" ref="ns1:author"/>
        <xs:element minOccurs="0" ref="ns1:tags"/>
        <xs:element minOccurs="0" ref="ns1:langs"/>
        <xs:element minOccurs="0" ref="ns1:settings"/>
        <xs:element minOccurs="0" ref="ns1:variables"/>
        <xs:element ref="ns1:blocks"/>
      </xs:sequence>
      <xs:attribute name="id" use="required" type="xs:string"/>
      <xs:attribute name="source_format" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:token">
            <xs:enumeration value="json"/>
            <xs:enumeration value="yaml"/>
            <xs:enumeration value="ir"/>
            <xs:enumeration value="xml"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="name" type="xs:string"/>
  <xs:element name="author" type="xs:string"/>
  <xs:element name="tags">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="ns1:tag"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="tag" type="xs:string"/>
  <xs:element name="langs">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="ns1:lang"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="settings" type="ns1:any-content"/>
  <xs:element name="variables">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="ns1:variable"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="blocks">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="ns1:block"/>
      </xs:sequence>
      <xs:attribute name="languageVersion" use="required"/>
    </xs:complexType>
  </xs:element>
  <!--
    ====================================================================
    Language definition
    ====================================================================
  -->
  <xs:element name="lang">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="ns1:title"/>
